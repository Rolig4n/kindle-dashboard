# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
TZ=America/Sao_Paulo

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
# Crie sua chave gratuita em: https://openweathermap.org/api
OWM_API_KEY=SUA_CHAVE_AQUI
OWM_CITY=Sao Paulo,BR
OWM_UNITS=metric

# ── Clima interno ──────────────────────────────────────────────────────────────
# URL do endpoint do container de sensores (temperatura/umidade da casa)
# Deixe vazio se ainda não tiver configurado
# O endpoint deve retornar JSON no formato: { "temperature": 23.5, "humidity": 60 }
HOME_CLIMATE_URL=

# ── RSS de notícias ────────────────────────────────────────────────────────────
# Feeds separados por vírgula
RSS_FEEDS=https://g1.globo.com/rss/g1/,https://feeds.feedburner.com/uolnoticias
RSS_MAX_ITEMS=20

# ── Galeria de imagens ─────────────────────────────────────────────────────────
# URLs de imagens separadas por vírgula (exibidas fora do horário comercial)
# Recomendado: imagens em P&B ou com alto contraste, tamanho próximo de 800x600
GALLERY_URLS=https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/Bianco_e_nero.jpg/800px-Bianco_e_nero.jpg,https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Hubble_Trifid.jpg/800px-Hubble_Trifid.jpg
